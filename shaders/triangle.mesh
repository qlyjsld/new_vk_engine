#version 460

#extension GL_EXT_mesh_shader: require

layout (local_size_x = 1) in;
layout (triangles, max_vertices = 3, max_primitives = 1) out;

layout (location = 0) out per_vertex_data
{
    vec4 color;
} v_out[];

const vec3 vertices[3] = {vec3(-.6f, .6f, 0.f), vec3(0.f, -.6f, 0.f),
    vec3(.6f, .6f, 0.f)};

const vec3 colors[3] = {vec3(1.f, 0.f, 0.f), vec3(0.f, 1.f, 0.f),
    vec3(0.f, 0.f, 1.f)};

void main()
{
    SetMeshOutputsEXT(3, 1);

    v_out[0].color = vec4(colors[0], 1.f);
    v_out[1].color = vec4(colors[1], 1.f);
    v_out[2].color = vec4(colors[2], 1.f);

    gl_MeshVerticesEXT[0].gl_Position = vec4(vertices[0], 1.f);
    gl_MeshVerticesEXT[1].gl_Position = vec4(vertices[1], 1.f);
    gl_MeshVerticesEXT[2].gl_Position = vec4(vertices[2], 1.f);

    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
}