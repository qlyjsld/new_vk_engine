#version 460

#extension GL_EXT_mesh_shader: require

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout (triangles, max_vertices = 64, max_primitives = 126) out;

struct vertex
{
    vec3 pos;
    vec3 normal;
    vec2 texcrood;
};

struct meshlet
{
    uint vertex_index[64];
    uint indices[378];
    uint vertex_count;
    uint index_count;
};

layout (set = 0, binding = 0) uniform readonly RENDER_MAT
{
    mat4 view;
    mat4 proj;
    mat4 model;
} render_mat;

layout (set = 1, binding = 0) buffer readonly VERTICES
{
    vertex vertices[];
} vertices;

layout (set = 2, binding = 0) buffer readonly MESHLETS
{
    meshlet mshlets[];
} meshlets;

layout (location = 0) out per_vertex_data
{
    vec2 texcrood;
} v_out[];

void main()
{
    meshlet m = meshlets.mshlets[gl_WorkGroupID.x];
    for (uint i = 0; i < m.vertex_count; ++i) {
        vertex v = vertices.vertices[m.vertex_index[i]];
        gl_MeshVerticesNV[i].gl_Position =
            render_mat.proj * render_mat.view * render_mat.model * vec4(v.pos, 1.f);
        v_out[i].texcrood = v.texcrood;
    }

    for (uint i = 0; i < m.index_count; ++i)
        gl_PrimitiveTriangleIndicesEXT[i] = m.indices[i];

    gl_PrimitiveCountNV = m.index_count / 3;
}